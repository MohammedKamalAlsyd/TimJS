{
    "manifest_version": 3,
    "name": "TimJS",
    "version": "0.0.1",
    "description": "TimJS is an AI-powered browser tool that helps you understand and improve your online behavior.",
    "action": {
      "default_popup": "index.html",
      "default_icon": "public/icon.svg"
    },
    "icons": {
        "16": "icon.svg",
        "48": "icon.svg",
        "128": "icon.svg"
    },
    "background": {
      "service_worker": "assets/background.js"
    },
    "permissions": ["tabs","activeTab", "storage"],
    "host_permissions": ["<all_urls>"]
  }