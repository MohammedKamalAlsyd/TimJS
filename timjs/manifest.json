{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.0.1",
  "author": "Mohammed Kamal",
  "name": "TimJS",
  "description": "TimJS is an AI-powered browser tool that helps you understand and improve your online behavior.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "src/imgs/icon.png"
  },
  "icons": {
    "16": "src/imgs/icon.png",
    "48": "src/imgs/icon.png",
    "128": "src/imgs/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "src/utils/background.js"
  },
  "commands": {
    "clear_local_storage": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Clear all local storage data (testing only)"
    },
    "load_test_data": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "description": "Load test data into local storage (testing only)"
    }
  },
  "permissions": ["tabs", "activeTab", "storage", "favicon"],
  "host_permissions": ["<all_urls>"]
}
