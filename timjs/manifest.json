{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "1.0.0",
  "author": "Mohammed Kamal",
  "name": "TimJS",
  "description": "Track and analyze your browsing habits to optimize your online behavior.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "src/imgs/icon.png"
  },
  "icons": {
    "16": "src/imgs/icon.png",
    "48": "src/imgs/icon.png",
    "128": "src/imgs/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/shorts/*","https://www.youtube.com/watch*"],
      "js": ["src/content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "src/utils/background.js"
  },
  "externally_connectable": {
    "matches": ["*://*.youtube.com/*"]
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "windows",
    "favicon",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://icons.duckduckgo.com/ip3/*",
    "http://www.google.com/s2/favicons?domain=*"
  ]
}
